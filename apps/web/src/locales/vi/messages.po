msgid "{0, plural, one {event in the history} other {events in the history}}"
msgstr "{0, plural, one {sự kiện trong lịch sử} other {sự kiện trong lịch sử}}"

msgid "That passphrase doesn't open this export's secrets."
msgstr "Cụm mật khẩu đó không mở được các bí mật của bản xuất này."

msgid "Too many tries. Try again in an hour."
msgstr "Quá nhiều lần thử. Thử lại sau một giờ."

msgid "The secrets will be imported"
msgstr "Các bí mật sẽ được nhập"

msgid "The passphrase opened them. They stay encrypted until the import writes them."
msgstr "Cụm mật khẩu đã mở chúng. Chúng vẫn được mã hóa cho đến khi quá trình nhập ghi chúng."

msgid "It holds encrypted secrets"
msgstr "Nó chứa các bí mật đã mã hóa"

msgid "Enter the passphrase chosen when it was exported to import them too. Without it, everything else is imported."
msgstr "Nhập cụm mật khẩu đã chọn khi xuất để nhập cả chúng. Không có nó, mọi thứ khác vẫn được nhập."

msgid "Passphrase"
msgstr "Cụm mật khẩu"

msgid "Open the secrets"
msgstr "Mở các bí mật"

msgid "People to invite"
msgstr "Người cần mời"

msgid "Nobody is invited by the import: invite each person yourself, with their email."
msgstr "Quá trình nhập không mời ai cả: tự mời từng người bằng email của họ."

msgid "Not imported: a file type Kept doesn't keep."
msgstr "Không được nhập: loại tệp mà Kept không giữ."

msgid "The file isn't in the archive, so it's left out."
msgstr "Tệp không có trong bản lưu trữ nên bị bỏ qua."

msgid "The file is larger than Kept takes, so it's left out."
msgstr "Tệp lớn hơn mức Kept nhận nên bị bỏ qua."

msgid "Not something Kept reads from an export; ignored."
msgstr "Không phải thứ Kept đọc từ bản xuất; bị bỏ qua."

msgid "Archived in Homebox, left out."
msgstr "Đã lưu trữ trong Homebox, bị bỏ qua."

msgid "Counted one by one in Kept; Homebox's quantity is kept in the notes."
msgstr "Đếm từng cái một trong Kept; số lượng của Homebox được giữ trong ghi chú."

msgid "Quantity 0 became 1: Homebox gives 0 when none was set."
msgstr "Số lượng 0 thành 1: Homebox cho ra 0 khi không đặt số lượng nào."

msgid "Homebox keeps numbers whole, so any decimals were already lost there."
msgstr "Homebox chỉ giữ số nguyên nên mọi số thập phân đã mất ở đó rồi."

msgid "Kept has no icon like Homebox's; the type's own icon is used."
msgstr "Kept không có biểu tượng giống của Homebox; biểu tượng riêng của loại được dùng."

msgid "A Kept template can't hold money or secrets; the rest of the template is imported."
msgstr "Mẫu Kept không chứa được tiền hay bí mật; phần còn lại của mẫu được nhập."

msgid "This currency isn't turned on in Kept; the prices are kept in the notes."
msgstr "Đơn vị tiền tệ này chưa bật trong Kept; giá được giữ trong ghi chú."

msgid "Kept can't hold this record yet; its text is kept in the thing's notes."
msgstr "Kept chưa chứa được bản ghi này; văn bản của nó được giữ trong ghi chú của đồ vật."

msgid "A location inside an item became a container."
msgstr "Một địa điểm bên trong một mục trở thành một vật chứa."

msgid "Notifiers are never imported: their addresses can hold passwords."
msgstr "Trình thông báo không bao giờ được nhập: địa chỉ của chúng có thể chứa mật khẩu."

msgid "One of Homebox's starter places or tags, empty and unused, left out."
msgstr "Một địa điểm hoặc thẻ mẫu của Homebox, trống và không dùng, bị bỏ qua."

msgid "A date Homebox filled in with the day the item was made; read as empty."
msgstr "Một ngày mà Homebox điền bằng ngày tạo mục; được đọc là trống."

msgid "It holds more than {n} files."
msgstr "Nó chứa hơn {n} tệp."

msgid "It's larger than {gb} GB."
msgstr "Nó lớn hơn {gb} GB."

msgid "One of its files unpacks to far more than its size, the way a booby-trapped archive does."
msgstr "Một trong các tệp của nó giải nén ra lớn hơn nhiều so với kích thước của nó, giống như một bản lưu trữ gài bẫy."

msgid "It holds a link to somewhere outside the archive."
msgstr "Nó chứa một liên kết tới nơi ngoài bản lưu trữ."

msgid "One of its file names points outside the archive."
msgstr "Một trong các tên tệp của nó trỏ ra ngoài bản lưu trữ."

msgid "Two of its files have the same name."
msgstr "Hai trong các tệp của nó trùng tên."

msgid "It's incomplete: the download or the copy stopped before the end."
msgstr "Nó chưa đầy đủ: quá trình tải xuống hoặc sao chép đã dừng trước khi xong."

msgid "It's from a newer version than this Kept reads. Update Kept, then import it."
msgstr "Nó thuộc phiên bản mới hơn phiên bản Kept này đọc được. Cập nhật Kept rồi nhập nó."

msgid "It's protected with a ZIP password, which Kept can't open. Export it again without one."
msgstr "Nó được bảo vệ bằng mật khẩu ZIP mà Kept không mở được. Xuất lại mà không dùng mật khẩu."

msgid "One of its data files is too large to read."
msgstr "Một trong các tệp dữ liệu của nó quá lớn để đọc."

msgid "One thing per row, with a header row naming the columns."
msgstr "Một đồ vật mỗi hàng, kèm hàng tiêu đề ghi tên các cột."

msgid "A Homebox export"
msgstr "Một bản xuất Homebox"

msgid "Homebox v0.26 or newer: Collection settings → Export. Older than v0.26: update Homebox first."
msgstr "Homebox v0.26 trở lên: Cài đặt bộ sưu tập → Xuất. Cũ hơn v0.26: cập nhật Homebox trước."

msgid "A Kept export"
msgstr "Một bản xuất Kept"

msgid "A location exported from this Kept or another one. It comes in as a new location."
msgstr "Một địa điểm xuất từ Kept này hoặc Kept khác. Nó được nhập thành một địa điểm mới."

msgid "Give the new location a name."
msgstr "Đặt tên cho địa điểm mới."

msgid "Its timezone and currency are this device's; change them later in Location settings."
msgstr "Múi giờ và đơn vị tiền tệ của nó theo thiết bị này; đổi sau trong Cài đặt địa điểm."

msgid "A new location"
msgstr "Một địa điểm mới"

msgid "Made in your account, with its own Unplaced area."
msgstr "Được tạo trong tài khoản của bạn, kèm khu vực Unplaced riêng."

msgid "A Kept export always comes in as a new location."
msgstr "Bản xuất Kept luôn được nhập thành một địa điểm mới."

msgid "A location you run"
msgstr "Một địa điểm bạn quản lý"

msgid "<0>{names}</0>. Things already there stay; importing the same export again adds only what's new."
msgstr "<0>{names}</0>. Các đồ vật đã có vẫn ở đó; nhập lại cùng bản xuất chỉ thêm những gì mới."

msgid "Deleting <0>{name}</0> removes it for everyone in it. It stays restorable for 30 days."
msgstr "Xóa <0>{name}</0> sẽ gỡ nó khỏi mọi người trong đó. Nó vẫn khôi phục được trong 30 ngày."

msgid "Delete <0>{name}</0>…"
msgstr "Xóa <0>{name}</0>…"

msgid "Deleted {0}. It can be restored for 30 days."
msgstr "Đã xóa {0}. Có thể khôi phục trong 30 ngày."

msgid "Delete <0>{name}</0>?"
msgstr "Xóa <0>{name}</0>?"

msgid "Type {name} to confirm"
msgstr "Nhập {name} để xác nhận"

msgid "That isn't the location's name."
msgstr "Đó không phải tên của địa điểm."

msgid "<0>{name}</0> stays restorable for 30 days, then it's gone with its files."
msgstr "<0>{name}</0> vẫn khôi phục được trong 30 ngày, sau đó nó biến mất cùng các tệp của nó."

