#!/bin/bash
# The Home Assistant app's start (D272; the app spec's §5.2): Kept and Postgres 18 in one container,
# everything that lasts under /data, which Home Assistant keeps across updates and backs up.
#
#   1. the options (/data/options.json), Kept's address and the Supervisor's version, as Kept's
#      environment (options.mjs), which also sends Home Assistant the discovery message for the Kept
#      integration (#376); then SUPERVISOR_TOKEN is dropped, before anything else starts;
#   2. to 8. the steps the Unraid image shares (docker/one-container.sh): /data's folders
#      re-owned (the spike's T11: Supervisor 2026.10.5 restores files as root), the database made or
#      restored, Postgres as `postgres`, the logins, `kept migrate` with the owner login, Kept as uid
#      10001, and on TERM a dump for the next backup (kept-ha-backup: the Supervisor runs backup_pre
#      only while the app runs, so a backup of a stopped app holds its last stop's dump). If either
#      process exits, the Supervisor's watchdog restarts the app.
#
# KEPT_HA_DEMO is set only by the test-only local app (homeassistant/.test/kept-demo): a person
# can't set an app's environment from Home Assistant.
set -euo pipefail
umask 077

# shellcheck source=../one-container.sh
. /usr/local/lib/kept-ha/one-container.sh

# Postgres's binaries run without the secrets the options exported (options.mjs SECRET_VARIABLES):
# a server process has no use for them.
PG_ENV_UNSET=(-u KEPT_SMTP_URL -u KEPT_OIDC_CLIENT_SECRET -u KEPT_GOOGLE_CLIENT_SECRET -u KEPT_APPRISE_URL)

# 1. The options and the address. The values go through a root-only file, never argv.
install -d -m 0700 /run/kept-ha
# The link secret (#376) lives in /data/config, which step 2 hands to Kept's user.
install -d -m 0700 "$DATA/config"
LINK_SECRET_FILE=$DATA/config/home-assistant-link
node /usr/local/lib/kept-ha/options.mjs --options "$DATA/options.json" \
  --link-secret "$LINK_SECRET_FILE" >/run/kept-ha/env
# shellcheck source=/dev/null
. /run/kept-ha/env
rm -f /run/kept-ha/env
# The Supervisor's token was needed for that alone: nothing started after this line gets it.
unset SUPERVISOR_TOKEN HASSIO_TOKEN

# 2. Ownership, every start. options.json (it may hold the mail password) is root's alone.
[[ ! -f $DATA/options.json ]] || chmod 0600 "$DATA/options.json"
own_data

# 3. and 4. A database, made or restored; Postgres.
make_database
start_postgres

# 5. and 6. The logins, a restore, then the migrations.
bootstrap_logins
restore_dump

# Kept's environment: its three runtime logins and the Supervisor as its one trusted proxy (Core's
# hop behind it is skipped for an ingress request only, apps/server/src/http/ingress.ts proxiesFor).
export_kept_env
export KEPT_TRUSTED_PROXIES=172.30.32.2
# The secret Home Assistant's discovery message carries (#376): the integration asks with it, and a
# person approves in Kept. Without the file (it couldn't be written), linking is off.
if [[ -s $LINK_SECRET_FILE ]]; then export KEPT_HA_LINK_SECRET_FILE=$LINK_SECRET_FILE; fi
export KEPT_LOG_FORMAT=pretty
run_migrate

# 7. Kept.
start_kept

# The test-only demo data: once, on a database this start made.
if [[ ${KEPT_HA_DEMO:-} == households && -n $fresh && -z $restore ]]; then
  (
    for _ in $(seq 120); do
      node -e 'fetch("http://127.0.0.1:8080/readyz").then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))' && break
      sleep 1
    done
    log "TEST ONLY: loading the households demo data (KEPT_HA_DEMO)"
    as_kept env NODE_ENV=development kept admin seed --scenario households >/dev/null &&
      log "TEST ONLY: demo data loaded; every password is kept-seed-password"
  ) &
fi

# 8. Until either process exits, or the Supervisor stops the app.
wait_for_exit
