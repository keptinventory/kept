msgid "Tracking"
msgstr "Theo dõi"

msgid "Open {expected}"
msgstr "Mở {expected}"

msgid "This Kept is set up for <0>{expected}</0>. Open it there."
msgstr "Kept này được thiết lập cho <0>{expected}</0>. Hãy mở nó ở đó."

msgid "This Kept is set up for a different address. Open it at the address you were given."
msgstr "Kept này được thiết lập cho một địa chỉ khác. Hãy mở nó tại địa chỉ bạn được cung cấp."

msgid "This Kept is set up for {address}. Open it there."
msgstr "Kept này được thiết lập cho {address}. Hãy mở nó ở đó."

msgid "In Homebox, open Collection → Tools → Backup & Restore and choose Create Backup. When the backup is listed, Download it: that .zip is the file."
msgstr "Trong Homebox, mở Collection → Tools → Backup & Restore rồi chọn Create Backup. Khi bản sao lưu xuất hiện trong danh sách, hãy Download nó: tệp .zip đó chính là tệp cần dùng."

msgid "Homebox v0.26.1 or newer (v0.27.0 recommended): Collection → Tools → Backup & Restore → Create Backup → Download. Older than v0.26: import its spreadsheet export, or update a copy of Homebox first."
msgstr "Homebox v0.26.1 trở lên (khuyên dùng v0.27.0): Collection → Tools → Backup & Restore → Create Backup → Download. Cũ hơn v0.26: hãy nhập bản xuất bảng tính của nó, hoặc cập nhật một bản sao Homebox trước."

msgid "On a home network without HTTPS, the person who runs this Kept can make one on the server: kept admin token create."
msgstr "Trên mạng gia đình không có HTTPS, người vận hành Kept này có thể tạo một token trên máy chủ: kept admin token create."

msgid "Open the map"
msgstr "Mở bản đồ"

msgid "Things: sort by"
msgstr "Đồ vật: sắp xếp theo"

msgid "{count, plural, one {+# box} other {+# boxes}}"
msgstr "{count, plural, one {+# thùng} other {+# thùng}}"

msgid "Allow private addresses in Admin → Settings"
msgstr "Cho phép địa chỉ riêng tư trong Quản trị viên → Cài đặt"

msgid "Passkeys need HTTPS. On a plain-HTTP address browsers don't offer them; put Kept on HTTPS to add one."
msgstr "Passkey cần HTTPS. Trên địa chỉ HTTP thuần, trình duyệt không cung cấp passkey; hãy đưa Kept lên HTTPS để thêm passkey."

msgid "{0, plural, one {secret value left out of the export} other {secret values left out of the export}}"
msgstr "{0, plural, one {giá trị bí mật bị bỏ khỏi bản xuất} other {giá trị bí mật bị bỏ khỏi bản xuất}}"

msgid "Staying on my home network"
msgstr "Giữ trên mạng gia đình của tôi"

msgid "Over plain HTTP, secret values stay out of the export. Each one is marked as left out, and the rest imports as usual."
msgstr "Qua HTTP thuần, các giá trị bí mật sẽ không có trong bản xuất. Mỗi giá trị đều được đánh dấu là bị bỏ qua, và phần còn lại vẫn nhập như thường."

msgid "Opening them needs HTTPS. Over plain HTTP everything else is imported without them; to bring them over too, import this file at Kept’s HTTPS address."
msgstr "Mở chúng cần HTTPS. Qua HTTP thuần, mọi thứ khác đều được nhập mà không có chúng; để mang chúng theo cùng, hãy nhập tệp này tại địa chỉ HTTPS của Kept."

