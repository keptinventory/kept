msgstr "语义搜索已暂停至 {until} · 当前显示关键词结果"

msgid "Send a test"
msgstr "发送测试"

msgid "Send to"
msgstr "发送至"

msgid "Send to {0}"
msgstr "发送到 {0}"

msgid "Server address"
msgstr "服务器地址"

msgid "Set <0>KEPT_OIDC_ISSUER</0>, <1>KEPT_OIDC_CLIENT_ID</1> and <2>KEPT_OIDC_CLIENT_SECRET</2>, then restart Kept."
msgstr "请设置 <0>KEPT_OIDC_ISSUER</0>、<1>KEPT_OIDC_CLIENT_ID</1> 和 <2>KEPT_OIDC_CLIENT_SECRET</2>，然后重启 Kept。"

msgid "Set Request Body to JSON with two text fields: <0>value</0>, the number you typed, and <1>takenAt</1>, the Current Date formatted as ISO 8601 with the time."
msgstr "将请求体 (Request Body) 设为包含两个文本字段的 JSON：<0>value</0> 为你输入的数值，<1>takenAt</1> 为含时间的 ISO 8601 格式当前日期。"

