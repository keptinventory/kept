msgstr "{PARENT} là mã riêng của nó; {PADDED} đệm thành hai chữ số."

msgid "A grid is 1 to {side} across and up, at most {most} cubes; shelves and drawers 1 to {count}."
msgstr "Một lưới có từ 1 đến {side} ô theo chiều ngang và chiều dọc, tối đa {most} ô vuông; kệ và ngăn kéo từ 1 đến {count}."

