---
/**
 * The check after an install step (#492): what Kept prints or shows when the step worked. The
 * label is the page's language; the lines are what Kept really prints (commands.ts `printed`) or
 * the app's own words in that language.
 */
import { langOf, pick } from '../../i18n';
import { install } from '../../words';

const t = pick(install, langOf(Astro.locals.starlightRoute.lang));
---

<div class="kd-see">
  <p class="kd-see-label">{t.see}</p>
  <slot />
</div>

<style is:global>
  .kd-see {
    margin-block-start: 0.75rem;
    padding-block: 0.5rem;
    padding-inline: 0.875rem;
    border-inline-start: 3px solid var(--ok);
    border-start-end-radius: 6px;
    border-end-end-radius: 6px;
    background: var(--surface);
  }
  .kd-see > * {
    margin-block: 0;
  }
  .kd-see > * + * {
    margin-block-start: 0.375rem;
  }
  .kd-see-label {
    color: var(--ok);
    font-size: 0.8125rem;
    font-weight: 600;
  }
</style>
