msgstr "Đã nâng cấp từ <0>{from}</0> lên <1>{to}</1> mà không có bản sao lưu"

msgid "Use a backup password of at least 12 characters. A few words are easiest."
msgstr "Dùng mật khẩu sao lưu dài ít nhất 12 ký tự. Vài từ là dễ nhất."

