msgstr "Mã đó không khớp. Hãy thử mã mới nhất mà ứng dụng của bạn hiển thị."

msgid "That conflicts with a change someone else made. Reload and try again."
msgstr "Điều đó xung đột với thay đổi của người khác. Tải lại và thử lại."

msgid "That didn't work"
msgstr "Không thành công"

msgid "That doesn't look like an email address."
msgstr "Trông không giống một địa chỉ email."

msgid "That email or username and password don't match."
msgstr "Email hoặc tên người dùng và mật khẩu đó không khớp."

msgid "That key is already a field of this type, one it inherits from, or one below it. Pick another key."
msgstr "Khóa đó đã là một trường của loại này, của một loại mà nó kế thừa, hoặc của một loại bên dưới nó. Hãy chọn khóa khác."

msgid "That label isn't on a thing in your Kept."
msgstr "Nhãn đó không gắn với đồ vật nào trong Kept của bạn."

msgid "That name is already in this list. Merge the two instead."
msgstr "Tên đó đã có trong danh sách này. Thay vào đó, hãy gộp hai cái lại."

msgid "That passkey couldn't confirm it's you. Use a code instead."
msgstr "Passkey đó không xác nhận được đó là bạn. Thay vào đó, hãy dùng một mã."

msgid "That passkey isn't registered here. Sign in another way, then add it."
msgstr "Passkey đó chưa được đăng ký ở đây. Hãy đăng nhập bằng cách khác, rồi thêm nó."

msgid "That password isn't right."
msgstr "Mật khẩu đó không đúng."

msgid "That setup code isn't right. Check the server's logs."
msgstr "Mã cài đặt đó không đúng. Hãy kiểm tra nhật ký của máy chủ."

msgid "That share has expired"
msgstr "Liên kết chia sẻ đó đã hết hạn"

msgid "That username and code don't match, or the code has expired. Ask for a new one."
msgstr "Tên người dùng và mã đó không khớp, hoặc mã đã hết hạn. Hãy yêu cầu mã mới."

msgid "That would give a field key twice: a group or parent already has a field this type defines. Remove the clash first."
msgstr "Điều đó sẽ tạo trùng khóa trường: một nhóm hoặc loại cha đã có một trường mà loại này định nghĩa. Hãy xóa xung đột trước."

msgid "That would give the field “{clash}” twice: a group or parent already has it. Remove the clash first."
msgstr "Điều đó sẽ tạo trùng trường “{clash}”: một nhóm hoặc loại cha đã có nó. Hãy xóa xung đột trước."

msgid "That's already on the list."
msgstr "Cái đó đã có trong danh sách rồi."

msgid "That's already your email address."
msgstr "Đó đã là địa chỉ email của bạn rồi."

msgid "That's in another location. Move it from its own page."
msgstr "Cái đó ở một vị trí khác. Hãy di chuyển nó từ trang của chính nó."

msgid "That's turned off in this location."
msgstr "Tính năng đó đã tắt ở vị trí này."

msgid "The 6 characters printed under the QR code."
msgstr "6 ký tự in dưới mã QR."

msgid "The assistant may read it"
msgstr "Trợ lý có thể đọc nó"

msgid "The camera needs a secure (HTTPS) address, and this page doesn't have one. Your admin can put Kept on HTTPS."
msgstr "Máy ảnh cần một địa chỉ bảo mật (HTTPS), mà trang này không có. Quản trị viên của bạn có thể đưa Kept lên HTTPS."

msgid "The code is 6 letters and digits, like K7Q-2M9."
msgstr "Mã gồm 6 chữ cái và chữ số, ví dụ K7Q-2M9."

msgid "The code is 8 characters."
msgstr "Mã gồm 8 ký tự."

msgid "The current item"
msgstr "Mục hiện tại"

msgid "The email-change link is missing its code. Open it straight from the email, or start again from Settings."
msgstr "Liên kết đổi email thiếu mã của nó. Hãy mở trực tiếp từ email, hoặc bắt đầu lại từ Cài đặt."

msgid "The first things in <0>{home}</0> go where you choose. You can change it any time from the place at the top."
msgstr "Những đồ vật đầu tiên trong <0>{home}</0> sẽ đến nơi bạn chọn. Bạn có thể thay đổi bất cứ lúc nào từ vị trí ở trên cùng."

msgid "The inbox is for members"
msgstr "Hộp thư đến dành cho thành viên"

msgid "The key and kind stay as they are. Changing a kind comes with a preview, later."
msgstr "Khóa và loại địa điểm giữ nguyên như cũ. Việc thay đổi loại địa điểm sẽ kèm bản xem trước, sau này."

msgid "The lines don't add up to the total (more than 1% apart). Check them."
msgstr "Các dòng không cộng lại bằng tổng (lệch hơn 1%). Hãy kiểm tra lại."

msgid "The link is missing its code. Open it straight from the message, or scan the QR code again."
msgstr "Liên kết thiếu mã của nó. Hãy mở trực tiếp từ tin nhắn, hoặc quét lại mã QR."

msgid "The link stops working. Anyone who hasn't opened it yet will need a new one."
msgstr "Liên kết sẽ ngừng hoạt động. Bất kỳ ai chưa mở nó sẽ cần một liên kết mới."

msgid "the location"
msgstr "vị trí"

msgid "The lookup didn't answer. You can still add it."
msgstr "Tra cứu không trả lời. Bạn vẫn có thể thêm nó."

msgid "The lowest is above the highest."
msgstr "Giá trị thấp nhất cao hơn giá trị cao nhất."

msgid "The monthly cap is reached"
msgstr "Đã đạt giới hạn hàng tháng"

msgid "The monthly token limit is reached"
msgstr "Đã đạt giới hạn token hàng tháng"

msgid "The old meter's last reading ({unit})"
msgstr "Chỉ số cuối cùng của đồng hồ cũ ({unit})"

msgid "The one already in Kept, <0>{0}</0>"
msgstr "Cái đã có trong Kept, <0>{0}</0>"

msgid "The original is kept. This format can't be previewed yet."
msgstr "Bản gốc được giữ lại. Định dạng này chưa xem trước được."

msgid "The owner is told about every new managed account."
msgstr "Chủ sở hữu được thông báo về mỗi tài khoản được quản lý mới."

msgid "The people who run this server manage users, sign-up and jobs here. Ask one of them if something needs changing."
msgstr "Những người vận hành máy chủ này quản lý người dùng, đăng ký và tác vụ tại đây. Hãy hỏi một người trong số họ nếu có gì cần thay đổi."

msgid "The price paid for one, as recorded on its purchase."
msgstr "Giá đã trả cho một cái, như đã ghi trong lần mua của nó."

msgid "The recovery kit comes first"
msgstr "Bộ khôi phục cần làm trước"

msgid "The reset link is missing its code. Open it straight from the email, or ask for a new one on the sign-in page."
msgstr "Liên kết đặt lại thiếu mã của nó. Hãy mở trực tiếp từ email, hoặc yêu cầu mã mới trên trang đăng nhập."

msgid "The server couldn't apply it."
msgstr "Máy chủ không áp dụng được."

msgid "The server is busy making previews. Try again in a moment; nothing was lost."
msgstr "Máy chủ đang bận tạo bản xem trước. Hãy thử lại sau một lát; không có gì bị mất."

msgid "The sign-in link is missing its code. Open it straight from the email, or ask for a new one."
msgstr "Liên kết đăng nhập thiếu mã của nó. Hãy mở trực tiếp từ email, hoặc yêu cầu mã mới."

msgid "The things it finds stay."
msgstr "Những thứ nó tìm được vẫn còn."

msgid "The total is a number, like 5800.00."
msgstr "Tổng là một con số, ví dụ 5800.00."

msgid "The trash is empty"
msgstr "Thùng rác trống"

msgid "The tray stays with you, offline too."
msgstr "Khay vẫn đi cùng bạn, cả khi ngoại tuyến."

msgid "Their access, and any tokens they make, stop on this date."
msgstr "Quyền truy cập của họ, và bất kỳ token nào họ tạo, sẽ dừng vào ngày này."

msgid "Their access, and any tokens they make, stop on this date. It can't be later than your own, {capText}."
msgstr "Quyền truy cập của họ, và bất kỳ token nào họ tạo, sẽ dừng vào ngày này. Ngày đó không thể muộn hơn ngày của chính bạn, {capText}."

msgid "Their authenticator and backup codes stop working, and they set two-factor up again at their next sign-in. They get an email about it."
msgstr "Mã xác thực và mã dự phòng của họ sẽ ngừng hoạt động, và họ sẽ thiết lập lại xác thực hai lớp ở lần đăng nhập tiếp theo. Họ sẽ nhận được email về việc này."

msgid "Their other changes are already in. For each field below, choose which version to keep."
msgstr "Các thay đổi khác của họ đã được đưa vào. Với mỗi trường dưới đây, hãy chọn phiên bản muốn giữ."

msgid "them"
msgstr "chúng"

msgid "Theme"
msgstr "Chủ đề"

msgid "Then set KEPT_PUBLIC_URL to the https address and restart Kept."
msgstr "Sau đó đặt KEPT_PUBLIC_URL thành địa chỉ https và khởi động lại Kept."

msgid "There are {0}. The ones you take off get their own row, keeping the same purchase."
msgstr "Có {0}. Những cái bạn gỡ ra sẽ có hàng riêng, vẫn giữ cùng lần mua."

msgid "There's already a kind with that name."
msgstr "Đã có một loại địa điểm với tên đó."

msgid "These fields leave the type. Their values are archived on each thing, not deleted, and come back if the field does:"
msgstr "Các trường này rời khỏi loại. Giá trị của chúng được lưu trữ trên từng đồ vật, không bị xóa, và sẽ quay lại nếu trường đó quay lại:"

msgid "These things change type:"
msgstr "Những đồ vật này đổi loại:"

msgid "These values will be archived"
msgstr "Các giá trị này sẽ được lưu trữ"

msgid "They go to the trash with their photos. You can restore them for 30 days."
msgstr "Chúng sẽ vào thùng rác cùng với ảnh của chúng. Bạn có thể khôi phục chúng trong 30 ngày."

msgid "They stay on the thing under Archived fields, and come back if you re-type again."
msgstr "Chúng vẫn ở trên đồ vật trong mục Trường đã lưu trữ, và sẽ quay lại nếu bạn đặt lại loại."

msgid "They're somewhere else"
msgstr "Chúng ở nơi khác"

msgid "Thing"
msgstr "Đồ vật"

msgid "Thing, receipt, label or reading. Switch any time; the camera stays open."
msgstr "Đồ vật, biên lai, nhãn hoặc chỉ số. Chuyển đổi bất cứ lúc nào; máy ảnh vẫn mở."

msgid "Things"
msgstr "Đồ vật"

msgid "Things affected"
msgstr "Đồ vật bị ảnh hưởng"

msgid "Things by {name}"
msgstr "Đồ vật theo {name}"

msgid "Things captured with no place yet"
msgstr "Đồ vật đã chụp mà chưa có vị trí"

msgid "Things found"
msgstr "Đồ vật tìm được"

msgid "Things in the same location, by brand and model or by name."
msgstr "Đồ vật ở cùng vị trí, theo hãng và mẫu mã hoặc theo tên."

msgid "Things moved"
msgstr "Đồ vật đã di chuyển"

msgid "Things show here when a purchase from here is recorded for them."
msgstr "Đồ vật hiển thị ở đây khi một lần mua từ đây được ghi cho chúng."

msgid "Things show here when you set their brand."
msgstr "Đồ vật hiển thị ở đây khi bạn đặt hãng của chúng."

msgid "Things show here when you set who they belong to, on the thing's page."
msgstr "Đồ vật hiển thị ở đây khi bạn đặt chủ sở hữu của chúng, trên trang của đồ vật."

msgid "Things with this label"
msgstr "Đồ vật có nhãn này"

msgid "Things you run out of"
msgstr "Đồ vật bạn dùng hết"

msgid "Things, vehicles and paperwork."
msgstr "Đồ vật, phương tiện và giấy tờ."

msgid "This account runs the server: users, sign-up and backups. It can't see inside anyone's home unless they invite it."
msgstr "Tài khoản này vận hành máy chủ: người dùng, đăng ký và sao lưu. Nó không thể xem bên trong nhà của bất kỳ ai trừ khi họ mời."

msgid "This address doesn't lead to a page in Kept. The link may be old."
msgstr "Địa chỉ này không dẫn đến một trang trong Kept. Liên kết có thể đã cũ."

msgid "This batch"
msgstr "Đợt này"

msgid "this box"
msgstr "hộp này"

msgid "This browser can't open the camera here."
msgstr "Trình duyệt này không mở được camera ở đây."

msgid "This browser can't read codes with the camera."
msgstr "Trình duyệt này không đọc được mã bằng camera."

msgid "This browser may clear Kept's offline copy after weeks unused. Open Kept to sync soon."
msgstr "Trình duyệt này có thể xóa bản sao ngoại tuyến của Kept sau vài tuần không dùng. Hãy mở Kept để đồng bộ sớm."

msgid "This changed since you opened it. Reload and try again."
msgstr "Nội dung này đã thay đổi từ khi bạn mở. Hãy tải lại và thử lại."

msgid "This code isn't one of Kept's labels. It says:"
msgstr "Mã này không phải là một nhãn của Kept. Nó ghi:"

msgid "This device"
msgstr "Thiết bị này"

msgid "This device has no camera Kept can use."
msgstr "Thiết bị này không có camera mà Kept có thể dùng."

msgid "This device stays signed in. The others need your password or passkey again."
msgstr "Thiết bị này vẫn giữ đăng nhập. Các thiết bị khác cần mật khẩu hoặc passkey của bạn lần nữa."

