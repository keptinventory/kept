msgstr "转换读数"

msgid "Every reading, the replacement offset, the daily limit and the schedules on this odometer change to {toLabel}."
msgstr "此里程表上的每条读数、更换偏移量、每日上限和计划都将切换为 {toLabel}。"

msgid "Relabel only"
msgstr "仅重新贴标"

msgid "The readings were always in {toLabel}. Every value stays as it is."
msgstr "读数原本就是以 {toLabel} 为单位记录的，所有数值将保持原样。"

msgid "New unit"
msgstr "新单位"

msgid "Only the unit's name changes. The readings stay as they are."
msgstr "仅更改单位名称，已有读数保持不变。"

msgid "Latest reading: {0} {fromLabel} becomes {1} {toLabel}"
msgstr "最新读数：{0} {fromLabel} 将转换为 {1} {toLabel}"

msgid "{0, plural, one {# reading changes} other {# readings change}}"
msgstr "{0, plural, one {# 条读数将变更} other {# 条读数将变更}}"

msgid "Replacement offset: {0} becomes {1}"
msgstr "替换偏移量：{0} 变为 {1}"

msgid "Daily limit: {0} becomes {1}"
msgstr "每日上限：由 {0} 调整为 {1}"

msgid "{0, plural, one {# schedule on it changes} other {# schedules on it change}}"
msgstr "{0, plural, one {其上的 # 个计划将随之更改} other {其上的 # 个计划将随之更改}}"

msgid "It goes in the history, and you can undo it."
msgstr "操作会记入历史记录，且你可以随时撤销。"

msgid "A room is at least {min} across."
msgstr "房间宽度至少为 {min}。"

msgid "A room is at most {max} across."
msgstr "房间宽度上限为 {max}。"

msgid "{a} × {b} in"
msgstr "{a} × {b} 英寸"

msgid "{width} in tape"
msgstr "{width} 英寸色带"

msgid "The photo shows {seenUnit}, and this odometer counts {unit}. {0} {seenUnit} is {1} {unit}."
msgstr "照片显示单位为 {seenUnit}，而此里程表使用 {unit}。换算关系：{0} {seenUnit} = {1} {unit}。"

msgid "Use {0} {unit}"
msgstr "消耗 {0} {unit}"

msgid "Readings converted"
msgstr "已转换读数"

msgid "Meter unit changed"
msgstr "表计单位已更改"

msgid "Water purifier"
msgstr "净水器"

msgctxt "how many shelves"
msgid "Shelves"
msgstr "层数"

msgid "Counts are off"
msgstr "盘点功能未开启"

msgid "An owner or admin turns them on in a location's What to track."
msgstr "所有者或管理员可在空间设置的「追踪内容」中开启此功能。"

msgid "Counts are off here: this lists the box checks."
msgstr "此处未开启盘点功能：下方仅列出箱内核对记录。"
