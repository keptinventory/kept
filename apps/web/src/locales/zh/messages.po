msgstr "校验推送消息 (Node.js)"

msgid "Claude Desktop"
msgstr "Claude Desktop"

msgid "Configured, not working"
msgstr "已配置，但无法正常工作"

msgid "Connected apps"
msgstr "已连接的应用"

msgid "Connected apps (OAuth)"
msgstr "已连接应用 (OAuth)"

