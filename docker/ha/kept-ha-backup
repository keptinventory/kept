#!/bin/bash
# The Home Assistant app's backup_pre (D272; the app spec's §10.2), and the dump kept-ha-start
# takes when the app stops.
#
# Home Assistant backs the app up hot: Kept keeps serving. Before, this writes a consistent dump of
# the database to /data/backup/kept.pgdump (pg_dump as the superuser over the socket, to a temporary
# file, then renamed), and the live cluster (/data/postgres) is left out of the backup
# (config.yaml `backup_exclude`). A failed dump exits non-zero and leaves the previous dump, so the
# backup fails where the person sees it instead of saving one without the database. The dump stays
# after the backup: the Supervisor runs backup_pre only while the app runs, so a backup of a stopped
# app holds the dump its last stop wrote. When the app starts with no database and a dump (a
# restore), kept-ha-start restores from it.
set -euo pipefail
umask 077

DIR=/data/backup
DUMP=$DIR/kept.pgdump

install -d -m 0700 -o postgres -g postgres "$DIR"
rm -f "$DUMP.tmp"
start=$(date +%s)
if ! setpriv --reuid=postgres --regid=postgres --init-groups -- \
  /usr/lib/postgresql/18/bin/pg_dump -h /run/postgresql -U postgres -d kept -Fc -f "$DUMP.tmp"; then
  rm -f "$DUMP.tmp"
  echo "app: the database dump for the backup failed" >&2
  exit 1
fi
mv -f "$DUMP.tmp" "$DUMP"
sync "$DUMP"
echo "app: database dumped for the backup in $(($(date +%s) - start)) s ($(du -h "$DUMP" | cut -f1))"
