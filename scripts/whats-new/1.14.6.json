{
  "media": [
    {
      "file": "spanish.webp",
      "path": "/settings",
      "setup": [
        { "waitFor": { "role": "combobox", "name": "Language" } },
        { "click": { "role": "combobox", "name": "Language" } },
        { "click": { "role": "option", "name": "Español" } },
        { "waitFor": { "role": "heading", "name": "Configuración" } },
        { "click": { "role": "link", "name": "Inicio" } },
        { "wait": 1500 }
      ],
      "steps": [{ "wait": 400 }],
      "crop": [0, 0, 1280, 800]
    },
    {
      "file": "language-search.mp4",
      "path": "/settings",
      "setup": [{ "waitFor": { "role": "combobox", "name": "Language" } }, { "scroll": 0 }],
      "steps": [
        { "click": { "role": "combobox", "name": "Language" } },
        { "wait": 900 },
        { "type": "ukr" },
        { "wait": 1200 },
        { "press": "Enter" },
        { "wait": 1500 }
      ],
      "crop": [248, 70, 1024, 640]
    }
  ]
}
