msgstr "Đã thay thế khóa mã hóa"

msgid "Old encryption key removed"
msgstr "Đã xóa khóa mã hóa cũ"

msgid "Semantic search source changed"
msgstr "Đã thay đổi nguồn tìm kiếm ngữ nghĩa"

msgid "Recovery kit downloaded"
msgstr "Đã tải xuống bộ khôi phục"

msgid "Checked for updates"
msgstr "Đã kiểm tra cập nhật"

